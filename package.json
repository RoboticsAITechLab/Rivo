{
  "name": "rivo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "lint": "npm run lint --workspace=web",
    "build": "npm run build --workspace=web",
    "test:auth": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/__tests__/auth-matrix.test.ts",
    "test:id": "tsx --tsconfig apps/web/tsconfig.json apps/web/src/__tests__/id-generator.test.ts",
    "test": "npm run test:auth && npm run test:id"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "ioredis": "^6.0.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "resend": "^6.28.1"
  }
}

