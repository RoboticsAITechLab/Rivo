# ==========================================
# RIVO SAAS ENVIRONMENT CONFIGURATION
# ==========================================

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# Email Delivery (Resend)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="no-reply@rivo.school"
RESEND_FROM_NAME="Rivo School Management"
APP_URL="http://localhost:3000"

# Redis (Distributed Rate Limiting & Session Cache)
# Local mode: Optional (falls back gracefully)
# Production mode: STRICTLY REQUIRED (fails closed if absent)
REDIS_URL="redis://localhost:6379"

# Security & MFA Encryption
# 32+ byte cryptographically secure key for AES-256-GCM encryption of TOTP secrets
MFA_ENCRYPTION_KEY="replace-with-a-cryptographically-secure-32-byte-secret"

# Infrastructure Mode: 'local' | 'production'
AUTH_INFRA_MODE="local"
