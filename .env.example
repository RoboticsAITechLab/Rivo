# ==============================================================================
# RIVO PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# All real values must be configured securely in Vercel or your secrets manager.
# NEVER COMMIT ACTUAL CREDENTIALS.
# ==============================================================================

# Database Connection (Neon PostgreSQL with connection pooler)
DATABASE_URL=

# Direct Database Connection (Neon direct host for DDL/migrations)
DIRECT_URL=

# Email Delivery (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# Security & MFA Encryption (32+ byte string for AES-256-GCM TOTP secret encryption)
MFA_ENCRYPTION_KEY=

# Distributed In-Memory Datastore (Upstash / Redis)
# In production, required for distributed rate limiting & token revocation.
REDIS_URL=

# Authentication Infrastructure Mode: "local" (in-memory rate limit) | "production" (Redis fail-closed)
AUTH_INFRA_MODE=

# Public Client Configuration (Safe for browser injection)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=
