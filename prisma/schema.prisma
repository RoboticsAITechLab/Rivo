datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  SCHOOL_ADMIN
  TEACHER
  STAFF
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  TRANSFERRED
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum AcademicSessionStatus {
  UPCOMING
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  EXCUSED
}

model School {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  status                  SchoolStatus             @default(TRIAL)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             SchoolMembership[]
  campuses                Campus[]
  students                Student[]
  parents                 Parent[]
  teachers                Teacher[]
  academicSessions        AcademicSession[]
  classes                 Class[]
  sections                Section[]
  subjects                Subject[]
  studentEnrollments      StudentEnrollment[]
  teacherAssignments      TeacherAssignment[]
  attendanceRegisters     AttendanceRegister[]
  attendanceAuditLogs     AttendanceAuditLog[]
  customRoles             CustomRole[]
  userPermissionOverrides UserPermissionOverride[]
  timetableSlots          TimetableSlot[]
  examTerms               ExamTerm[]
  sessions                Session[]
  staffInvitations        StaffInvitation[]
  securityAuditLogs       SecurityAuditLog[]
  idSequences             IdSequence[]
  idFormatConfig          IdFormatConfig?

  @@index([status])
  @@map("schools")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  phone                   String?
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  lastLoginAt             DateTime?                @map("last_login_at")
  isActive                Boolean                  @default(true)
  isPlatformOwner         Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             SchoolMembership[]
  teachers                Teacher[]
  students                Student[]
  parents                 Parent[]
  userPermissionOverrides UserPermissionOverride[]
  sessions                Session[]
  invitationsCreated      StaffInvitation[]        @relation("InvitedByUser")
  passwordResetTokens     PasswordResetToken[]
  securityAuditLogs       SecurityAuditLog[]
  mfa                     UserMfa?
  mfaRecoveryCodes        MfaRecoveryCode[]
  mfaChallenges           MfaChallenge[]

  @@map("users")
}

model SchoolMembership {
  id           String           @id @default(uuid())
  userId       String
  schoolId     String
  role         Role
  customRoleId String?          @map("custom_role_id")
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  customRole   CustomRole?      @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@index([schoolId, status])
  @@index([userId])
  @@index([role])
  @@index([customRoleId])
  @@map("school_memberships")
}

model Student {
  id                String              @id @default(uuid())
  schoolId          String
  campusId          String?             @map("campus_id")
  userId            String?
  admissionNumber   String
  firstName         String
  lastName          String
  gender            String?
  dateOfBirth       DateTime?
  bloodGroup        String?             @map("blood_group")
  stream            String?
  house             String?
  phone             String?
  email             String?
  address           String?
  status            StudentStatus       @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus            Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentStudents    ParentStudent[]
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  documents         StudentDocument[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([campusId])
  @@index([userId])
  @@index([schoolId, status])
  @@map("students")
}

model StudentDocument {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  documentType String   @map("document_type") // BIRTH_CERTIFICATE, PREVIOUS_MARKSHEET, TRANSFER_CERTIFICATE, etc.
  title        String
  fileUrl      String   @map("file_url")
  fileName     String?  @map("file_name")
  fileSize     String?  @map("file_size")
  status       String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

model Parent {
  id             String          @id @default(uuid())
  schoolId       String
  userId         String?
  firstName      String
  lastName       String
  phone          String?
  email          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentStudents ParentStudent[]

  @@index([schoolId])
  @@index([userId])
  @@map("parents")
}

model ParentStudent {
  id               String             @id @default(uuid())
  parentId         String
  studentId        String
  relationshipType ParentRelationship @default(GUARDIAN)
  isPrimaryContact Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  parent           Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

model Teacher {
  id             String              @id @default(uuid())
  schoolId       String
  campusId       String?             @map("campus_id")
  userId         String
  employeeId     String?
  phone          String?
  department     String?
  designation    String?
  qualification  String?
  status         TeacherStatus       @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus         Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignments    TeacherAssignment[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, userId])
  @@index([schoolId])
  @@index([campusId])
  @@index([userId])
  @@index([schoolId, status])
  @@map("teachers")
}

model AcademicSession {
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  startDate           DateTime
  endDate             DateTime
  status              AcademicSessionStatus @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]
  teacherAssignments  TeacherAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableSlots      TimetableSlot[]
  examTerms           ExamTerm[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, status])
  @@map("academic_sessions")
}

model Class {
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  displayOrder        Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections            Section[]
  enrollments         StudentEnrollment[]
  teacherAssignments  TeacherAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableSlots      TimetableSlot[]
  examSchedules       ExamSchedule[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id                  String               @id @default(uuid())
  schoolId            String
  classId             String
  name                String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments         StudentEnrollment[]
  teacherAssignments  TeacherAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableSlots      TimetableSlot[]
  examSchedules       ExamSchedule[]

  @@unique([classId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("sections")
}

model Subject {
  id                  String               @id @default(uuid())
  schoolId            String
  name                String
  code                String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherAssignments  TeacherAssignment[]
  attendanceRegisters AttendanceRegister[]
  timetableSlots      TimetableSlot[]
  examPapers          ExamPaper[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

model StudentEnrollment {
  id                String           @id @default(uuid())
  schoolId          String
  studentId         String
  academicSessionId String
  classId           String
  sectionId         String
  status            EnrollmentStatus @default(ACTIVE)
  enrolledAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicSession   AcademicSession  @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  class             Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  section           Section          @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicSessionId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicSessionId])
  @@index([classId, sectionId])
  @@map("student_enrollments")
}

model TeacherAssignment {
  id                String          @id @default(uuid())
  schoolId          String
  teacherId         String
  academicSessionId String
  classId           String
  sectionId         String
  subjectId         String?
  isClassTeacher    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher           Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject           Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([teacherId, academicSessionId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([academicSessionId])
  @@index([classId, sectionId])
  @@map("teacher_assignments")
}

model AttendanceRegister {
  id                String               @id @default(uuid())
  schoolId          String
  academicSessionId String
  classId           String
  sectionId         String
  date              DateTime
  subjectId         String?
  timetableEntryId  String?
  createdByUserId   String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  school            School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession   AcademicSession      @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class             Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  section           Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject           Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  records           AttendanceRecord[]
  auditLogs         AttendanceAuditLog[]

  @@unique([schoolId, academicSessionId, classId, sectionId, date, subjectId])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([classId, sectionId])
  @@index([date])
  @@map("attendance_registers")
}

model AttendanceRecord {
  id             String             @id @default(uuid())
  registerId     String
  studentId      String
  status         AttendanceStatus   @default(PRESENT)
  reason         String?
  markedByUserId String
  markedAt       DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  register       AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student        Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([registerId, studentId])
  @@index([registerId])
  @@index([studentId])
  @@map("attendance_records")
}

model AttendanceAuditLog {
  id                String              @id @default(uuid())
  schoolId          String
  registerId        String?
  action            String
  performedByUserId String
  details           String?
  createdAt         DateTime            @default(now())
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  register          AttendanceRegister? @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([registerId])
  @@map("attendance_audit_logs")
}

// ==========================================
// CAMPUS MODEL
// ==========================================

model Campus {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  name      String
  code      String?
  address   String?
  city      String?
  state     String?
  phone     String?
  email     String?
  isMain    Boolean   @default(false) @map("is_main")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]
  teachers  Teacher[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("campuses")
}

// ==========================================
// GRANULAR PERMISSION SYSTEM
// ==========================================

enum PermissionScope {
  SCHOOL
  CAMPUS
  ASSIGNED
  OWN
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "attendance.view", "school_timetable.edit", "exam_timetable.view"
  module      String   // e.g. "attendance", "school_timetable", "exam_timetable", "students", "teachers"
  action      String   // e.g. "view", "create", "edit", "delete", "take", "publish"
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  userPermissions UserPermissionOverride[]

  @@map("permissions")
}

model CustomRole {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  name        String   // e.g. "Department Head", "Timetable Coordinator", "Senior Teacher"
  code        String   // e.g. "TIMETABLE_COORD", "SENIOR_TEACHER"
  baseRole    Role     @map("base_role")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school          School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions  RolePermission[]
  memberships      SchoolMembership[]
  staffInvitations StaffInvitation[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("custom_roles")
}

model RolePermission {
  id           String          @id @default(uuid())
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  scope        PermissionScope @default(ASSIGNED)

  role       CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  id           String          @id @default(uuid())
  schoolId     String          @map("school_id")
  userId       String          @map("user_id")
  permissionId String          @map("permission_id")
  isGranted    Boolean         @default(true) @map("is_granted")
  scope        PermissionScope @default(ASSIGNED)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([schoolId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permission_overrides")
}

// ==========================================
// SCHOOL DAILY TIMETABLE (NORMAL)
// ==========================================

model TimetableSlot {
  id                String          @id @default(uuid())
  schoolId          String          @map("school_id")
  academicSessionId String          @map("academic_session_id")
  classId           String          @map("class_id")
  sectionId         String          @map("section_id")
  subjectId         String          @map("subject_id")
  teacherId         String          @map("teacher_id")
  dayOfWeek         String          @map("day_of_week") // MONDAY, TUESDAY, WEDNESDAY, etc.
  periodNumber      Int             @map("period_number")
  startTime         String          @map("start_time") // e.g. "08:30"
  endTime           String          @map("end_time") // e.g. "09:15"
  roomNumber        String?         @map("room_number")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  section         Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([academicSessionId, classId, sectionId, dayOfWeek, periodNumber])
  @@index([schoolId])
  @@index([academicSessionId])
  @@index([teacherId, dayOfWeek])
  @@index([classId, sectionId, dayOfWeek])
  @@map("timetable_slots")
}

// ==========================================
// FORMAL EXAM TIMETABLE (SEPARATE SYSTEM)
// ==========================================

model ExamTerm {
  id                String          @id @default(uuid())
  schoolId          String          @map("school_id")
  academicSessionId String          @map("academic_session_id")
  name              String          // e.g. "Mid-Term Examination 2026", "Annual Final Exam 2027"
  code              String?
  startDate         DateTime        @map("start_date")
  endDate           DateTime        @map("end_date")
  isPublished       Boolean         @default(false) @map("is_published")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  papers          ExamPaper[]

  @@unique([schoolId, academicSessionId, name])
  @@index([schoolId])
  @@index([academicSessionId])
  @@map("exam_terms")
}

model ExamPaper {
  id           String         @id @default(uuid())
  examTermId   String         @map("exam_term_id")
  subjectId    String         @map("subject_id")
  name         String         // e.g. "Mathematics Paper 1"
  maxMarks     Float          @default(100) @map("max_marks")
  passingMarks Float          @default(35) @map("passing_marks")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  examTerm  ExamTerm       @relation(fields: [examTermId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schedules ExamSchedule[]

  @@index([examTermId])
  @@index([subjectId])
  @@map("exam_papers")
}

model ExamSchedule {
  id         String    @id @default(uuid())
  paperId    String    @map("paper_id")
  classId    String    @map("class_id")
  sectionId  String    @map("section_id")
  examDate   DateTime  @map("exam_date")
  startTime  String    @map("start_time") // e.g. "09:00"
  endTime    String    @map("end_time") // e.g. "12:00"
  roomNumber String?   @map("room_number")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  class   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([paperId, classId, sectionId])
  @@index([paperId])
  @@index([classId, sectionId])
  @@index([examDate])
  @@map("exam_schedules")
}

// ==========================================
// AUTHENTICATION & SECURITY MODELS
// ==========================================

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  schoolId   String    @map("school_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schoolId])
  @@index([tokenHash])
  @@map("sessions")
}

model StaffInvitation {
  id           String    @id @default(uuid())
  schoolId     String    @map("school_id")
  email        String
  role         Role      @default(TEACHER)
  customRoleId String?   @map("custom_role_id")
  campusId     String?   @map("campus_id")
  department   String?
  designation  String?
  invitedById  String    @map("invited_by_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedBy  User        @relation("InvitedByUser", fields: [invitedById], references: [id], onDelete: Restrict)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([email])
  @@index([tokenHash])
  @@map("staff_invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model SecurityAuditLog {
  id        String   @id @default(uuid())
  schoolId  String?  @map("school_id")
  userId    String?  @map("user_id")
  event     String   // LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, LOGOUT_ALL, etc.
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   String?  // Sanitized JSON metadata
  createdAt DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([event])
  @@map("security_audit_logs")
}

model UserMfa {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  type            String    @default("TOTP")
  secretEncrypted String    @map("secret_encrypted")
  enabled         Boolean   @default(false)
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mfa")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([codeHash])
  @@map("mfa_recovery_codes")
}

model MfaChallenge {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  challengeHash String    @unique @map("challenge_hash")
  expiresAt     DateTime  @map("expires_at")
  attemptCount  Int       @default(0) @map("attempt_count")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeHash])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

model IdSequence {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  entityType String   @map("entity_type")
  year       Int?
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, entityType, year])
  @@index([schoolId])
  @@map("id_sequences")
}

model IdFormatConfig {
  id             String   @id @default(uuid())
  schoolId       String   @unique @map("school_id")
  studentPrefix  String   @default("STD") @map("student_prefix")
  teacherPrefix  String   @default("TCH") @map("teacher_prefix")
  staffPrefix    String   @default("STF") @map("staff_prefix")
  includeYear    Boolean  @default(true) @map("include_year")
  studentPadding Int      @default(4) @map("student_padding")
  teacherPadding Int      @default(4) @map("teacher_padding")
  staffPadding   Int      @default(4) @map("staff_padding")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("id_format_configs")
}

